{
    "configurations": [
        {
            "name": "ESP32-CAM (Arduino CLI)",
            "compilerPath": "${env:LOCALAPPDATA}/Arduino15/packages/esp32/tools/esp-x32/2601/bin/xtensa-esp32-elf-g++.exe",
            "compilerArgs": [
                "-mfix-esp32-psram-cache-issue",
                "-mfix-esp32-psram-cache-strategy=memw"
            ],
            "includePath": [
                "${workspaceFolder}/firmware/motiva-esp32-cam",
                "${env:LOCALAPPDATA}/Arduino15/packages/esp32/hardware/esp32/3.3.11/cores/esp32",
                "${env:LOCALAPPDATA}/Arduino15/packages/esp32/hardware/esp32/3.3.11/variants/esp32",
                "${env:LOCALAPPDATA}/Arduino15/packages/esp32/hardware/esp32/3.3.11/libraries/WiFi/src",
                "${env:LOCALAPPDATA}/Arduino15/packages/esp32/hardware/esp32/3.3.11/libraries/Network/src",
                "${env:LOCALAPPDATA}/Arduino15/packages/esp32/tools/esp32-libs/3.3.11/include/**",
                "${env:LOCALAPPDATA}/Arduino15/packages/esp32/tools/esp32-libs/3.3.11/qio_qspi/include"
            ],
            "defines": [
                "F_CPU=240000000L",
                "ARDUINO=10607",
                "ARDUINO_ESP32_DEV",
                "ARDUINO_ARCH_ESP32",
                "ARDUINO_BOARD=\"ESP32_DEV\"",
                "ARDUINO_VARIANT=\"esp32\"",
                "ARDUINO_PARTITION_huge_app",
                "ARDUINO_HOST_OS=\"windows\"",
                "ARDUINO_FQBN=\"esp32:esp32:esp32cam\"",
                "ESP32=ESP32",
                "CORE_DEBUG_LEVEL=0",
                "BOARD_HAS_PSRAM",
                "ARDUINO_USB_CDC_ON_BOOT=0"
            ],
            "cStandard": "gnu17",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "windows-gcc-x86"
        }
    ],
    "version": 4
}
